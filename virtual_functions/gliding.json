{
    "$id": "gradient",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Gradient Time Series Configuration",
    "description": "Configuration for computing aggregated gradients over a time series using a sliding time window, with optional interpolation of missing values.",
    "type": "object",
    "properties": {
        "interpolate_missing": {
            "type": "boolean",
            "description": "Whether missing data points in the time series should be interpolated prior to gradient computation.",
            "examples": [
                true,
                false
            ]
        },
        "data_frequency": {
            "type": "string",
            "description": "Time interval of the time series expressed as a pandas Timedelta-compatible string. Required when interpolate_missing is enabled (e.g., '1D', '15min').",
            "examples": [
                "1D",
                "15min",
                "2H",
                "30S"
            ]
        },
        "sliding_window": {
            "type": "string",
            "description": "Size of the sliding window expressed as a pandas Timedelta-compatible string used for gradient calculation (e.g., '7D', '1H').",
            "examples": [
                "7D",
                "1H",
                "30min"
            ]
        },
        "mode": {
            "type": "string",
            "enum": [
                "sum",
                "avg",
                "min",
                "max"
            ],
            "default": "sum",
            "description": "Aggregation mode applied to gradient values within each sliding window.",
            "examples": [
                "sum",
                "avg"
            ]
        }
    },
    "required": [
        "sliding_window"
    ],
    "additionalProperties": false,
    "allOf": [
        {
            "if": {
                "required": [
                    "interpolate_missing"
                ]
            },
            "then": {
                "required": [
                    "data_frequency"
                ]
            },
            "else": {
                "not": {
                    "required": [
                        "data_frequency"
                    ]
                }
            }
        }
    ],
    "examples": [
        {
            "sliding_window": "7D"
        },
        {
            "interpolate_missing": true,
            "data_frequency": "1D",
            "sliding_window": "14D",
            "mode": "avg"
        }
    ]
}