{
    "$id": "linear_function_schema",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Modified Time Series Configuration",
    "type": "object",
    "properties": {
        "interpolate_missing": {
            "type": "boolean"
        },
        "data_frequency": {
            "type": "string"
        },
        "factor": {
            "type": "number"
        },
        "offset": {
            "type": "number"
        }
    },
    "required": [
        "factor",
        "offset"
    ],
    "additionalProperties": false,
    "allOf": [
        {
            "if": {
                "required": [
                    "interpolate_missing"
                ]
            },
            "then": {
                "required": [
                    "data_frequency"
                ]
            },
            "else": {
                "not": {
                    "required": [
                        "data_frequency"
                    ]
                }
            }
        }
    ]
}